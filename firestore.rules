rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Toda la lectura/escritura de la app pasa por Cloud Functions
      // (Admin SDK), que omite estas reglas. El frontend no usa el SDK
      // cliente de Firestore, así que se deniega todo acceso directo.
      allow read, write: if false;
    }
  }
}
