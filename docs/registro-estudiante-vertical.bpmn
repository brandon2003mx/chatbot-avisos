<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_registro_v"
                  targetNamespace="http://tuxtla.tecnm.mx/chatbot-avisos">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Proceso" name="Proceso de alta de estudiantes en el bot de Telegram" processRef="Process_registro" />
  </bpmn:collaboration>

  <bpmn:process id="Process_registro" isExecutable="false">

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Estudiante" name="Estudiante">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_alta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bot" name="Bot de Telegram / Cloud Functions">
        <bpmn:flowNodeRef>ST_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_formato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_codigo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_intentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Inicio">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UT_1" name="Envía el comando /start">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_1" name="Muestra la bienvenida con el botón «Registrarme»">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_2" name="Pulsa «Registrarme»">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_2" name="Solicita el nombre completo">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_3" name="Escribe su nombre completo">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_3" name="Solicita el número de control">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_4" name="Escribe su número de control">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_formato" name="¿Tiene 8 dígitos?">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ST_4" name="Informa el error y permite reintentar">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="ST_5" name="Deduce el correo institucional y envía un código de 6 dígitos">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="CatchEvent_1" name="Recibe el correo con el código">
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="UT_5" name="Escribe el código de 6 dígitos">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_codigo" name="¿Código válido y vigente?">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="GW_intentos" name="¿Quedan intentos?">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ST_6" name="Informa el error y permite reintentar">
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_cancelado" name="Registro cancelado">
      <bpmn:incoming>F_18</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="ST_7" name="Muestra las carreras disponibles">
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_6" name="Elige su carrera">
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_8" name="Muestra los semestres de la carrera">
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:outgoing>F_22</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_7" name="Elige su semestre">
      <bpmn:incoming>F_22</bpmn:incoming>
      <bpmn:outgoing>F_23</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_9" name="Muestra los grupos del semestre">
      <bpmn:incoming>F_23</bpmn:incoming>
      <bpmn:outgoing>F_24</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_8" name="Elige su grupo">
      <bpmn:incoming>F_24</bpmn:incoming>
      <bpmn:outgoing>F_25</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_10" name="Guarda al estudiante con su telegramId y segmentación">
      <bpmn:incoming>F_25</bpmn:incoming>
      <bpmn:outgoing>F_26</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_11" name="Confirma el registro al estudiante">
      <bpmn:incoming>F_26</bpmn:incoming>
      <bpmn:outgoing>F_27</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_alta" name="Alta completada">
      <bpmn:incoming>F_27</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>El correo se deduce del número de control (l…@tuxtla.tecnm.mx). El código vence en 10 minutos y admite hasta 3 reenvíos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="ST_5" targetRef="TextAnnotation_1" />

    <bpmn:textAnnotation id="TextAnnotation_2">
      <bpmn:text>Máximo 5 intentos fallidos; al agotarse, el registro se cancela.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_2" sourceRef="GW_intentos" targetRef="TextAnnotation_2" />

    <bpmn:textAnnotation id="TextAnnotation_3">
      <bpmn:text>Se almacena en Firestore (colección estudiantes): número de control, nombre, correo, telegramId, carrera, semestre y grupo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_3" sourceRef="ST_10" targetRef="TextAnnotation_3" />

    <bpmn:sequenceFlow id="F_1" sourceRef="StartEvent_1" targetRef="UT_1" />
    <bpmn:sequenceFlow id="F_2" sourceRef="UT_1" targetRef="ST_1" />
    <bpmn:sequenceFlow id="F_3" sourceRef="ST_1" targetRef="UT_2" />
    <bpmn:sequenceFlow id="F_4" sourceRef="UT_2" targetRef="ST_2" />
    <bpmn:sequenceFlow id="F_5" sourceRef="ST_2" targetRef="UT_3" />
    <bpmn:sequenceFlow id="F_6" sourceRef="UT_3" targetRef="ST_3" />
    <bpmn:sequenceFlow id="F_7" sourceRef="ST_3" targetRef="UT_4" />
    <bpmn:sequenceFlow id="F_8" sourceRef="UT_4" targetRef="GW_formato" />
    <bpmn:sequenceFlow id="F_9" name="No" sourceRef="GW_formato" targetRef="ST_4" />
    <bpmn:sequenceFlow id="F_10" sourceRef="ST_4" targetRef="UT_4" />
    <bpmn:sequenceFlow id="F_11" name="Sí" sourceRef="GW_formato" targetRef="ST_5" />
    <bpmn:sequenceFlow id="F_12" sourceRef="ST_5" targetRef="CatchEvent_1" />
    <bpmn:sequenceFlow id="F_13" sourceRef="CatchEvent_1" targetRef="UT_5" />
    <bpmn:sequenceFlow id="F_14" sourceRef="UT_5" targetRef="GW_codigo" />
    <bpmn:sequenceFlow id="F_15" name="No" sourceRef="GW_codigo" targetRef="GW_intentos" />
    <bpmn:sequenceFlow id="F_16" name="Sí" sourceRef="GW_intentos" targetRef="ST_6" />
    <bpmn:sequenceFlow id="F_17" sourceRef="ST_6" targetRef="UT_5" />
    <bpmn:sequenceFlow id="F_18" name="No" sourceRef="GW_intentos" targetRef="EndEvent_cancelado" />
    <bpmn:sequenceFlow id="F_19" name="Sí" sourceRef="GW_codigo" targetRef="ST_7" />
    <bpmn:sequenceFlow id="F_20" sourceRef="ST_7" targetRef="UT_6" />
    <bpmn:sequenceFlow id="F_21" sourceRef="UT_6" targetRef="ST_8" />
    <bpmn:sequenceFlow id="F_22" sourceRef="ST_8" targetRef="UT_7" />
    <bpmn:sequenceFlow id="F_23" sourceRef="UT_7" targetRef="ST_9" />
    <bpmn:sequenceFlow id="F_24" sourceRef="ST_9" targetRef="UT_8" />
    <bpmn:sequenceFlow id="F_25" sourceRef="UT_8" targetRef="ST_10" />
    <bpmn:sequenceFlow id="F_26" sourceRef="ST_10" targetRef="ST_11" />
    <bpmn:sequenceFlow id="F_27" sourceRef="ST_11" targetRef="EndEvent_alta" />

  </bpmn:process>

