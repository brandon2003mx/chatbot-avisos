<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_avisos"
                  targetNamespace="http://tuxtla.tecnm.mx/chatbot-avisos">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Avisos" name="Proceso de avisos" processRef="Process_avisos" />
  </bpmn:collaboration>
  <bpmn:process id="Process_avisos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Coordinador" name="Coordinador">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_redactar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_segmento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_division</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_todos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_carrera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_semestre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_grupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_union</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_seguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>ST_verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_destinatarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_sin_destinatarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_sin_destinatarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_encolar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_lote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_limite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_reintentar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_lectura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_boton</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Chatbot" name="Chatbot">
        <bpmn:flowNodeRef>RCV_instruccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_entrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_confirmacion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Estudiantes" name="Estudiantes">
        <bpmn:flowNodeRef>RCV_notificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_leer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_confirmar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UT_redactar" name="Redactar aviso">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_segmento" name="Seleccionar segmento">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_division">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
      <bpmn:outgoing>F_5</bpmn:outgoing>
      <bpmn:outgoing>F_6</bpmn:outgoing>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_todos" name="Todos los estudiantes">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_carrera" name="Carrera">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_semestre" name="Semestre">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_grupo" name="Grupo">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_union">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_enviar" name="Enviar aviso">
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_seguimiento" name="Consultar seguimiento del aviso">
      <bpmn:incoming>F_33</bpmn:incoming>
      <bpmn:outgoing>F_34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1">
      <bpmn:incoming>F_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_verificar" name="Verificar sesión, rol y datos del aviso">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_consultar" name="Consultar estudiantes del segmento">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_destinatarios" name="¿Hay destinatarios?">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_sin_destinatarios" name="Informar segmento sin estudiantes">
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_sin_destinatarios" name="Aviso no registrado">
      <bpmn:incoming>F_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_registrar" name="Registrar aviso, destinatarios y lotes">
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_encolar" name="Encolar los lotes en Cloud Tasks">
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND_lote" name="Enviar el lote por Telegram Bot API">
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:incoming>F_23</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_limite" name="¿Telegram limitó el envío?">
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:outgoing>F_22</bpmn:outgoing>
      <bpmn:outgoing>F_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_reintentar" name="Reintentar el lote sin duplicar entregas">
      <bpmn:incoming>F_22</bpmn:incoming>
      <bpmn:outgoing>F_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_resultado" name="Registrar resultado por destinatario">
      <bpmn:incoming>F_24</bpmn:incoming>
      <bpmn:outgoing>F_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_lectura" name="Registrar lectura y actualizar contadores">
      <bpmn:incoming>F_31</bpmn:incoming>
      <bpmn:outgoing>F_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_boton" name="Deshabilitar el botón de lectura">
      <bpmn:incoming>F_32</bpmn:incoming>
      <bpmn:outgoing>F_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="RCV_instruccion" name="Recibe instrucción">
      <bpmn:incoming>F_25</bpmn:incoming>
      <bpmn:outgoing>F_26</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="SND_entrega" name="Entregar aviso con «Confirmar lectura»">
      <bpmn:incoming>F_26</bpmn:incoming>
      <bpmn:outgoing>F_27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SND_confirmacion" name="Enviar confirmación">
      <bpmn:incoming>F_30</bpmn:incoming>
      <bpmn:outgoing>F_31</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="RCV_notificacion" name="Recibir notificación">
      <bpmn:incoming>F_27</bpmn:incoming>
      <bpmn:outgoing>F_28</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="UT_leer" name="Leer aviso">
      <bpmn:incoming>F_28</bpmn:incoming>
      <bpmn:outgoing>F_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_confirmar" name="Confirmar lectura">
      <bpmn:incoming>F_29</bpmn:incoming>
      <bpmn:outgoing>F_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_1" sourceRef="Start_1" targetRef="UT_redactar" />
    <bpmn:sequenceFlow id="F_2" sourceRef="UT_redactar" targetRef="UT_segmento" />
    <bpmn:sequenceFlow id="F_3" sourceRef="UT_segmento" targetRef="GW_division" />
    <bpmn:sequenceFlow id="F_4" sourceRef="GW_division" targetRef="UT_todos" />
    <bpmn:sequenceFlow id="F_5" sourceRef="GW_division" targetRef="UT_carrera" />
    <bpmn:sequenceFlow id="F_6" sourceRef="GW_division" targetRef="UT_semestre" />
    <bpmn:sequenceFlow id="F_7" sourceRef="GW_division" targetRef="UT_grupo" />
    <bpmn:sequenceFlow id="F_8" sourceRef="UT_todos" targetRef="GW_union" />
    <bpmn:sequenceFlow id="F_9" sourceRef="UT_carrera" targetRef="GW_union" />
    <bpmn:sequenceFlow id="F_10" sourceRef="UT_semestre" targetRef="GW_union" />
    <bpmn:sequenceFlow id="F_11" sourceRef="UT_grupo" targetRef="GW_union" />
    <bpmn:sequenceFlow id="F_12" sourceRef="GW_union" targetRef="UT_enviar" />
    <bpmn:sequenceFlow id="F_13" sourceRef="UT_enviar" targetRef="ST_verificar" />
    <bpmn:sequenceFlow id="F_14" sourceRef="ST_verificar" targetRef="ST_consultar" />
    <bpmn:sequenceFlow id="F_15" sourceRef="ST_consultar" targetRef="GW_destinatarios" />
    <bpmn:sequenceFlow id="F_16" name="Sí" sourceRef="GW_destinatarios" targetRef="ST_registrar" />
    <bpmn:sequenceFlow id="F_17" name="No" sourceRef="GW_destinatarios" targetRef="ST_sin_destinatarios" />
    <bpmn:sequenceFlow id="F_18" sourceRef="ST_sin_destinatarios" targetRef="End_sin_destinatarios" />
    <bpmn:sequenceFlow id="F_19" sourceRef="ST_registrar" targetRef="ST_encolar" />
    <bpmn:sequenceFlow id="F_20" sourceRef="ST_encolar" targetRef="SND_lote" />
    <bpmn:sequenceFlow id="F_21" sourceRef="SND_lote" targetRef="GW_limite" />
    <bpmn:sequenceFlow id="F_22" name="Sí" sourceRef="GW_limite" targetRef="ST_reintentar" />
    <bpmn:sequenceFlow id="F_23" sourceRef="ST_reintentar" targetRef="SND_lote" />
    <bpmn:sequenceFlow id="F_24" name="No" sourceRef="GW_limite" targetRef="ST_resultado" />
    <bpmn:sequenceFlow id="F_25" sourceRef="ST_resultado" targetRef="RCV_instruccion" />
    <bpmn:sequenceFlow id="F_26" sourceRef="RCV_instruccion" targetRef="SND_entrega" />
    <bpmn:sequenceFlow id="F_27" sourceRef="SND_entrega" targetRef="RCV_notificacion" />
    <bpmn:sequenceFlow id="F_28" sourceRef="RCV_notificacion" targetRef="UT_leer" />
    <bpmn:sequenceFlow id="F_29" sourceRef="UT_leer" targetRef="UT_confirmar" />
    <bpmn:sequenceFlow id="F_30" sourceRef="UT_confirmar" targetRef="SND_confirmacion" />
    <bpmn:sequenceFlow id="F_31" sourceRef="SND_confirmacion" targetRef="ST_lectura" />
    <bpmn:sequenceFlow id="F_32" sourceRef="ST_lectura" targetRef="ST_boton" />
    <bpmn:sequenceFlow id="F_33" sourceRef="ST_boton" targetRef="UT_seguimiento" />
    <bpmn:sequenceFlow id="F_34" sourceRef="UT_seguimiento" targetRef="End_1" />
    <bpmn:textAnnotation id="Nota_1">
      <bpmn:text>Título (máx. 120 caracteres), mensaje (máx. 4,096, o 1,024 con imagen), imagen opcional y, si es un evento, su fecha y hora opcional.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_1" sourceRef="Nota_1" targetRef="UT_redactar" />
    <bpmn:textAnnotation id="Nota_2">
      <bpmn:text>Lotes de 50 destinatarios. Cloud Tasks procesa hasta 5 lotes a la vez y reintenta cada lote hasta 5 veces.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_2" sourceRef="Nota_2" targetRef="ST_encolar" />
    <bpmn:textAnnotation id="Nota_3">
      <bpmn:text>Destinatarios, enviados, lecturas confirmadas y errores. El panel se actualiza cada 5 s mientras el envío está en curso.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_Nota_3" sourceRef="Nota_3" targetRef="UT_seguimiento" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Avisos_di" bpmnElement="Participant_Avisos" isHorizontal="true">
