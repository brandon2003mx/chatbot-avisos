TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# FIRESTORE_EMULATOR_HOST no se lee de este archivo: expórtala en tu
# shell (no la pongas en .env) antes de correr scripts locales o
# `npm run serve` / `npm run telegram:dev`. Debe apuntar siempre al
# Firestore Emulator, nunca a un valor real de producción.
#   export FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
